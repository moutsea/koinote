# ============ 网络与端口 ============
BACKEND_PORT=8080
POSTGRES_PORT=5432
TZ=Asia/Shanghai
# Vite dev server 端口。改这个要同步改 ALLOWED_ORIGINS、APP_URL 以及
# OAuth 应用里登记的回调地址 —— 三处对不上会在回跳时才报错，很难查。
DEV_PORT=5273
# 本地跑生产构建物用（npm run build && npx vite preview）
PREVIEW_PORT=5274
# 允许携带 cookie 的跨域来源（dev: Vite 5273 / 本地 Worker 3000）
ALLOWED_ORIGINS=http://localhost:5273,http://localhost:3000

# ============ 环境标识 ============
# production 下 session cookie 会带 Secure 标志（仅 HTTPS）。
#
# 默认给 production：这个文件会被 cp 成 .env 直接用于部署，而漏改的方向必须是
# 安全的那一侧 —— 忘了改成 production 的后果是生产环境 cookie 不带 Secure，
# 忘了改成 development 的后果只是本地 http://localhost 下登录态存不住（当场就发现）。
# 本地开发请把这一行改成 development。
NODE_ENV=production

# ============ 数据库 ============
POSTGRES_USER=koinote
POSTGRES_PASSWORD=koinote
POSTGRES_DB=koinote
# 后端连库串（docker 内用服务名 postgres；本机直连用 localhost）
DATABASE_URL=postgres://koinote:koinote@localhost:5432/koinote?sslmode=disable

# ============ 鉴权与会话 ============
# session HMAC 签名密钥。必填，留空后端直接拒绝启动（不分环境，本地也一样）。
#
# 没有任何回退：曾经缺失时会回退到 BACKEND_INTERNAL_TOKEN 再兜底一个硬编码常量，
# 但那个常量在开源仓库里是公开的 —— 拿它就能签出任意用户的会话。已删掉。
#
#   openssl rand -base64 48
SESSION_SECRET=
# MCP 访问令牌的 AES-GCM 加密密钥。生产环境必须独立配置并长期保留；轮换它会让
# 既有令牌继续可用于鉴权，但无法再次查看。开发环境留空时复用 SESSION_SECRET。
#   openssl rand -base64 48
MCP_TOKEN_ENCRYPTION_KEY=
# 会员 BYOK API Key 的 AES-GCM 加密密钥。必须与 SESSION_SECRET、MCP 密钥和
# 任意第三方 API Key 分开，生产环境必填并长期保留；轮换前必须先迁移既有密文。
# 开发环境若留空会复用 SESSION_SECRET；生产环境必须单独配置并长期保留。
#   openssl rand -base64 48
LLM_CREDENTIAL_ENCRYPTION_KEY=
# 微信公众号 AppSecret 的 AES-GCM 加密密钥。各环境都必须独立配置并长期保留；
# 留空时公众号绑定不可用，不会回退复用 SESSION_SECRET。不要填写公众号 AppSecret 本身。
#   openssl rand -base64 48
WECHAT_CREDENTIAL_ENCRYPTION_KEY=
# Worker → 后端的内部鉴权令牌。必填，自己生成，别用任何示例值。
#
# 这个头能让持有者**伪造成任意用户** —— 后端见到它就信 X-Auth-User-Id 给的身份
# （见 authUserIDFromRequest），不再校验会话。所以它等同于全站管理员凭据。
#
# 这里刻意留空而不给示例值：之前写的是 koinote-internal-dev-token，而开源之后
# 那就是一个公开的万能钥匙 —— 实测拿它加上任意已知 authUserId 直连后端，
# 能拿到那个用户的全部文档（HTTP 200）。留空的后果只是"忘了配 → 图片记账不生效"，
# 比留一个能用的公开值安全得多。
#
# 反向也用它：后端的图片回收任务调 Worker 的删除端点时带上这个头。
# 三处必须一致：.env、.dev.vars（wrangler dev）、以及生产的
# `wrangler secret put BACKEND_INTERNAL_TOKEN`。不一致的表现是图片记账静默失败。
#
#   openssl rand -base64 36 | tr '+/' '-_' | tr -d '='
BACKEND_INTERNAL_TOKEN=

# ============ 邮箱注册验证 ============
# 验证码 HMAC 密钥。生产环境必填；开发环境留空时复用 SESSION_SECRET：
#   openssl rand -base64 48
# 与 SESSION_SECRET 一样属于凭据，不能提交真实值。
EMAIL_VERIFICATION_SECRET=
# 仅供本地开发：不发真实邮件，接口把 6 位测试码返回给注册页并自动填入。
# production 环境即使误设为 true 也会被后端忽略。
ENABLE_MOCK_EMAIL=false

# ============ Stripe 终生会员 ============
# Stripe Checkout 使用一次性多币种付款，支付后本站数据库发放终生权益。
# 本地使用 sk_test_ / price_ 测试值；真实值不要提交。
STRIPE_SECRET_KEY=
# 本地运行 `stripe listen --forward-to localhost:8080/api/billing/webhook` 后，
# 把 CLI 给出的 whsec_... 填到这里。开发环境可暂时留空并仅靠成功页确认；
# 生产环境必须配置，否则后端拒绝启动。
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard 中终生会员 Product 的 id（prod_...）。每次 Checkout 都按服务端
# 白名单为这个 Product 创建内联价格，用户不能从浏览器提交任意金额。
STRIPE_LIFETIME_PRODUCT_ID=
# Stripe Dashboard 中 Credits 充值共用 Product 的 id（prod_...）。三个套餐
# 由服务端创建内联 USD 价格：3000/$1.99、10000/$4.99、30000/$12.99。
STRIPE_CREDITS_PRODUCT_ID=

# ============ Agent 智能优化内置模型（可选） ============
# 四项必须同时填写或同时留空。留空只关闭平台 credits 调用，会员仍可使用 BYOK。
# OpenAI 兼容渠道填 openai，Base URL 通常包含 /v1；Anthropic 原生渠道填
# anthropic，后端会调用 /v1/messages。API Key 只进入后端。
AGENT_LLM_PROTOCOL=
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=

# ============ 微信公众号封面生成（可选） ============
# 三项必须同时填写或同时留空。API Key 只由 Go 后端读取，不要写入 Vite 变量。
# Base URL 通常包含 /v1，后端会自动补 /images/generations。
WECHAT_COVER_IMAGE_BASE_URL=
WECHAT_COVER_IMAGE_API_KEY=
WECHAT_COVER_IMAGE_MODEL=
# 可选的微信 API CONNECT 代理。生产通过 WireGuard 使用私网地址
# http://10.77.0.1:18080；本地 Docker 开发可填 http://host.docker.internal:18080，
# 并在宿主机建立 SSH 隧道到专用中转机。公网 HTTP 代理不允许使用。
WECHAT_API_PROXY_URL=

# ============ 飞书付款通知（可选） ============
# 沿用 Kimiseek 的机器人变量名和签名配置。只在 production 环境发送；两项必须
# 同时填写或同时留空。通知失败会由数据库队列重试，不会撤销已完成的付款与会员权益。
BOT_WEBHOOK=
BOT_WEBHOOK_SECRET=

# ============ Admin 站点流量（可选） ============
# 管理后台的用户、会员、收入等数据直接来自 Postgres，不依赖下面三项。
# 配齐后额外显示 Cloudflare 边缘口径的今日 UV、PV、请求数与流量。
CLOUDFLARE_ZONE_ID=
# 单独创建最小权限 Token，不要复用缓存清理 Token 或 CI 部署 Token。
# 权限：Zone / Analytics / Read；Zone Resources 只包含目标 Zone。
CLOUDFLARE_ANALYTICS_TOKEN=
# 留空时从 APP_URL 自动取 hostname；同一 Zone 有多个站点时可显式指定。
CLOUDFLARE_ANALYTICS_HOST=

# ============ Admin 服务器状态（通常无需修改） ============
# 裸机 Linux 开发默认读取 /proc 和 /；production compose 会自动改成只读的
# 宿主机指标挂载路径。其他容器部署方式需要提供同等的只读挂载。
HOST_METRICS_PROC_PATH=/proc
HOST_METRICS_FILESYSTEM_PATH=/

# ============ Admin 站内提醒翻译（可选） ============
# 三项同时配置后，管理员可在后台用一种语言编写提醒，由后端调用兼容 Anthropic
# Messages 的中转服务（POST /v1/messages）生成其余三种语言。中转服务会收到 API Key
# 和管理员编写的提醒正文，但不会收到用户账号、文档或图片；请只使用你信任的端点。
ANNOUNCEMENT_LLM_BASE_URL=
ANNOUNCEMENT_LLM_API_KEY=
ANNOUNCEMENT_LLM_MODEL=

# ============ 图片回收 ============
# Worker 基址，后端用它删除 R2 对象并通过 Email binding 发送注册验证码。
# 生产环境必须填站点基址（例如 https://koinote.app），否则邮箱注册无法使用。
# 本地使用 mock email 时可留空；图片待删记录仍会入队，配好后重启即可补上。
# 后端跑在容器里、Worker 跑在本机时用 host.docker.internal
WORKER_URL=
# Vite 在宿主机上访问本地 Worker；通常保持默认即可。
VITE_WORKER_URL=http://localhost:8788

# ============ PostgreSQL 异地备份（可选） ============
# `database-backup` compose profile 每隔 6 小时生成压缩、自带格式校验的 pg_dump，
# 用恢复证书进行 AES-256-GCM 加密后上传到私有 R2。失败 15 分钟后重试。
# 启用前必须先按 README 生成自己的证书/私钥并创建备份 bucket；私钥绝不能放在 VPS 或仓库。
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETRY_SECONDS=900

# ============ 云端存储配额 ============
# 每个用户的云端存储上限，单位 MB（1 MB = 1024 KB）。留空用默认的 500。
#
# 统计的是「文档正文 + 标题 + 图床对象」的总量 —— 文档存在 Postgres、图片存在 R2，
# 两者都是用户存在云端的东西。
#
# 单位是 MB 不是字节：写 500 比写 524288000 好读，也不容易少打一个 0。
# 填了字节数（比如 524288000）会被当成配置错误并回落到默认值，日志里会说明。
#
# 非数字、0、负数同样回落到默认 —— 0 的后果是所有人都传不了图，
# 那几乎不可能是本意。
#
# 与单张图上限的关系：单张图最大 10 MB（在 Worker 里，MAX_BYTES），
# 所以这个值填到 10 以下等于没人能传任何图。单篇文档上限 1 MB（后端 maxContentBytes）。
IMAGE_QUOTA_MB=500

# ============ 前端 → 后端（Worker / Vite dev proxy） ============
BACKEND_URL=http://localhost:8080

# ============ OAuth（Google / GitHub 第三方登录） ============
# APP_URL 是对外可访问的站点基址，用于拼 OAuth 回调地址。
# 本地开发填 Vite dev server 地址（前端同源，/api 代理到后端）；
# 生产填你的域名，如 https://koinote.app
APP_URL=http://localhost:5273
#
# 各 provider 的回调地址（在下方平台后台里填这个）：
#   Google → {APP_URL}/api/auth/oauth/google/callback
#   GitHub → {APP_URL}/api/auth/oauth/github/callback
# 例如本地：http://localhost:5273/api/auth/oauth/google/callback
#
# --- Google ---
# 申请：https://console.cloud.google.com/apis/credentials
#   1. 创建「OAuth 2.0 客户端 ID」，类型选「Web 应用」
#   2. 「已获授权的重定向 URI」填上面的 google callback 地址
#   3. 把生成的客户端 ID / 密钥填到这里
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# --- GitHub ---
# 申请：https://github.com/settings/developers → New OAuth App
#   1. Authorization callback URL 填上面的 github callback 地址
#   2. 生成 Client secret，连同 Client ID 填到这里
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
