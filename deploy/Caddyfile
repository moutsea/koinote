# 后端的 TLS 终止 + 反向代理。
#
# 为什么源站也要 HTTPS：Cloudflare 的 Flexible 模式下，浏览器→CF 是加密的，
# 但 CF→源站是明文 HTTP。而 Worker 会把浏览器的会话 cookie 转发给后端 ——
# 那段明文里就带着能直接登录任意账号的令牌。所以这里必须有真证书，
# 且 Cloudflare 的 SSL 模式要设成 Full (strict)。
#
# caddy 自动申请并续期 Let's Encrypt 证书，不需要 certbot 那套 cron。
# 证书存在 caddy-data 卷里（见 docker-compose.prod.yml），重启不会重签。

{
	# Proxy failures use the runtime logger as well as the access logger.
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp "[?].*$" ""
			}
		}
	}
}

api.koinote.app {
	# Public clients enter through the Worker. The origin credential is separate
	# from internal API authority; knowing an internal token alone cannot enter here.
	@untrusted {
		not path /health
		not header X-Koinote-Origin-Token {$BACKEND_ORIGIN_TOKEN}
	}
	respond @untrusted "Forbidden" 403

	# 后端在主机的回环口上（compose.prod 把它绑到 127.0.0.1:8080）
	reverse_proxy 127.0.0.1:8080 {
		# 把真实客户端 IP 传给后端。
		#
		# 后端的 requestIP()（ratelimit.go）读 X-Forwarded-For 做限流分桶，
		# 不传的话所有请求看起来都来自 caddy 一个 IP —— 限流会把全站用户
		# 当成同一个来源，10 次失败登录就能锁住所有人。
		#
		# 这里的值来自 Cloudflare 设的 CF-Connecting-IP：链路是
		# 浏览器 → CF → Worker → CF → caddy → 后端，而 Worker 已经把
		# cf-connecting-ip 写进 X-Forwarded-For（见 worker/index.ts）。
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	# The Worker strips caller-supplied forwarding and identity headers. Only its
	# authenticated origin requests can reach protected backend routes.

	encode gzip
	log_append forwarded_client_ip {http.request.header.CF-Connecting-IP}
	log_append user_agent {http.request.header.User-Agent}

	log {
		output file /data/access-safe.log {
			mode 0600
			roll_size 10mb
			roll_keep 3
		}
		# 只保留排障需要的 IP、UA、路径和状态；自定义内部鉴权头也不能落盘。
		# Query 中可能包含 OAuth code、签名或临时令牌，一并从日志中移除。
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp "[?].*$" ""
			}
		}
	}
}
