 describe("native evidence in independent stages", () => {
+	it.each([false, true])("isolates intent from execution capabilities while retaining review restrictions (clarification review=%s)", async clarification => {
+		const request = input();
+		request.systemPrompt = "APPLICATION_CAPABILITY_MARKER: This product also has account settings. All writes require the host's permission.";
+		request.taskContext!.responseChecks = true;
+		const candidate = JSON.parse(interpretation().text);
+		candidate.change = "clarify";
+		candidate.state.questions = ["Which grouping did you mean?"];
+		const outputs: ModelResponse[] = [
+			...(clarification ? [{ text: JSON.stringify(candidate) }] : []), interpretation(),
+			{ toolCalls: [{ id: "change", name: "files.change", arguments: { id: "file-a" } }] },
+			{ text: JSON.stringify({ decisions: [{ resourceId: "file-a", kind: "move", decision: "allow", reason: "User requested grouping", sources: [ref] }], question: "" }) },
+			{ text: "Done" }, { text: JSON.stringify({ decision: "accept", feedback: "" }) },
+		];
+		const h = harness("move", { outputs });
+		const result = await h.kernel.run(request);
+		expect(result.task?.question).toBeUndefined();
+		expect(h.execute).toHaveBeenCalledOnce();
+		let interpretations = 0, reviews = 0;
+		for (const [modelRequest] of h.generate.mock.calls) {
+			if (!modelRequest.messages[0].content.startsWith("INTERNAL PROTOCOL STAGE")) {
+				expect(modelRequest.messages.some(m => m.content.includes("APPLICATION_CAPABILITY_MARKER"))).toBe(true);
+				continue;
+			}
+			const query = modelRequest.messages.at(-1)!.content;
+			const envelope = JSON.parse(query.slice(query.indexOf("\n") + 1));
+			expect(modelRequest.messages.slice(1, -1)).toEqual(request.initialMessages);
+			if (query.includes("Interpret the effective task")) {
+				interpretations++;
+				expect(envelope).not.toHaveProperty("applicationContract");
+				expect(modelRequest.messages.some(m => m.content.includes("APPLICATION_CAPABILITY_MARKER"))).toBe(false);
+			} else {
+				reviews++;
+				expect(envelope.applicationContract).toBe(request.systemPrompt);
+			}
+		}
+		expect(interpretations).toBe(clarification ? 2 : 1);
+		expect(reviews).toBe(2);
+	});
 	it("reviews host-assigned IDs for supporting creations without confusing them with existing targets", async () => {
