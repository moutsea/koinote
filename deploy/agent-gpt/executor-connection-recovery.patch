+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdtemp, writeFile, chmod, rm, access } from 'node:fs/promises';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { fileURLToPath } from 'node:url';
+import { setTimeout as delay } from 'node:timers/promises';
+
+const entry = fileURLToPath(new URL('./agent.mjs', import.meta.url));
+async function launch(t, mode) {
+ const directory = await mkdtemp(join(tmpdir(), 'agent-connection-test-'));
+ const docker = join(directory, 'docker');
+ await writeFile(docker, '#!/bin/sh\ncase "$1" in\ninfo) printf \'{"runsc":{}}\\n\';;\nimage) printf \'[]\\n\';;\nps|rm) :;;\n*) exit 1;;\nesac\n');
+ await chmod(docker, 0o700);
+ const preload = join(directory, 'fake-control.mjs');
+ await writeFile(preload, `
+ const realNow = performance.now.bind(performance);
+ Object.defineProperty(performance, 'now', { value: () => realNow() * 1000 });
+ const interval = globalThis.setInterval;
+ globalThis.setInterval = (fn, ms, ...args) => interval(fn, ms === 1000 ? 5 : ms, ...args);
+ const mode = ${JSON.stringify(mode)};
+ globalThis.fetch = async (_url, init) => new Promise((_, reject) => {
+   process.stdout.write('fixture.input.pending\\n');
+   const fail = () => reject(new Error('fixture aborted'));
+   if (init.signal.aborted) fail(); else init.signal.addEventListener('abort', fail, { once: true });
+ });
+ globalThis.WebSocket = class extends EventTarget {
+   static CONNECTING=0; static OPEN=1; static CLOSING=2; static CLOSED=3;
+   readyState=0;
+   constructor() {
+     super(); this.hold=interval(() => {}, 60000);
+     if (mode !== 'connecting') queueMicrotask(() => { this.readyState=1; this.dispatchEvent(new Event('open')); });
+   }
+   send() {
+     if (mode !== 'healthy' && mode !== 'active' && mode !== 'idle-close') return;
+     const claims = mode === 'active' ? [{ id:'11111111-1111-4111-8111-111111111111', lease:'fixture-lease', serverNow:Date.now(), leaseUntil:Date.now()+300000 }] : [];
+     queueMicrotask(() => this.dispatchEvent(new MessageEvent('message', { data:JSON.stringify({ type:'sync', valid:[], stop:[], claims, serverNow:Date.now(), heartbeatMs:30000 }) })));
+     if (mode === 'active') setTimeout(() => this.close(),20);
+     if (mode === 'idle-close') setTimeout(() => { this.readyState=3;clearInterval(this.hold);const e=new Event('close');Object.defineProperty(e,'code',{value:1006});this.dispatchEvent(e);process.stdout.write('fixture.peer.closed\\n'); },130);
+   }
+   close() {
+     this.readyState=2;
+     if (mode === 'healthy' || mode === 'idle-close') { clearInterval(this.hold); this.readyState=3; const e=new Event('close'); Object.defineProperty(e,'code',{value:1000}); this.dispatchEvent(e); }
+   }
+ };
+ `);
+ const child = spawn(process.execPath, ['--import', preload, entry], { env:{ ...process.env, PATH:directory+':'+process.env.PATH, SANDBOX_WORKER_URL:'http://127.0.0.1', SANDBOX_NODE_ID:'connection-fixture', SANDBOX_NODE_TOKEN:'a'.repeat(72), SANDBOX_IMAGE:'sha256:'+'0'.repeat(64), SANDBOX_RUNTIME:'runsc', SANDBOX_STATE_DIR:join(directory,'state') }, stdio:['ignore','pipe','pipe'] });
+ let output='', error=''; child.stdout.on('data',b=>output+=b);child.stderr.on('data',b=>error+=b);
+ const completed=new Promise(resolve=>child.once('close',(code,signal)=>resolve({code,signal})));
+ const guard=setTimeout(()=>child.kill('SIGKILL'),4000);
+ t.after(async()=>{ clearTimeout(guard);if(child.exitCode===null&&child.signalCode===null) child.kill('SIGKILL');await completed;await rm(directory,{recursive:true,force:true}); });
+ const waitFor=async(marker)=>{for(let i=0;i<300;i++){if(output.includes(marker))return; if(child.exitCode!==null||child.signalCode!==null)break;await delay(5);}throw new Error('Fixture did not reach '+marker+': '+error);};
+ return { child, completed, waitFor, output:()=>output,error:()=>error, lock:join(directory,'state','agent.lock') };
+}
+for (const mode of ['connecting','closing']) test('unresponsive '+mode+' connection exits for supervisor recovery', async t=>{
+ const fixture=await launch(t,mode);const result=await fixture.completed;
+ assert.equal(result.code,1,fixture.error());assert.equal(result.signal,null);
+ assert.match(fixture.output(),/executor.connection_stalled/);
+ assert.doesNotMatch(fixture.output()+fixture.error(),/a{72}/);
+ await assert.rejects(access(fixture.lock));
+});
+test('healthy control connection stays running and drains normally', async t=>{
+ const fixture=await launch(t,'healthy');await fixture.waitFor('executor.connected');await delay(120);
+ assert.equal(fixture.child.exitCode,null);assert.doesNotMatch(fixture.output(),/connection_stalled/);
+ fixture.child.kill('SIGTERM');assert.deepEqual(await fixture.completed,{code:0,signal:null});await assert.rejects(access(fixture.lock));
+});
+test('stalled control connection does not restart while execution holds a lease', async t=>{
+ const fixture=await launch(t,'active');await fixture.waitFor('fixture.input.pending');await delay(100);
+ assert.equal(fixture.child.exitCode,null);assert.equal(fixture.child.signalCode,null);assert.doesNotMatch(fixture.output(),/connection_stalled/);
+});
+
+test('idle graceful shutdown exits even if the socket never closes', async t=>{
+ const fixture=await launch(t,'closing');await fixture.waitFor('executor.connected');await delay(20);
+ fixture.child.kill('SIGTERM');assert.deepEqual(await fixture.completed,{code:0,signal:null});await assert.rejects(access(fixture.lock));
+});
+
+test('idle peer close gets reconnect grace without needless restart', async t=>{
+ const fixture=await launch(t,'idle-close');await fixture.waitFor('fixture.peer.closed');await delay(15);
+ assert.equal(fixture.child.exitCode,null);assert.equal(fixture.child.signalCode,null);assert.doesNotMatch(fixture.output(),/connection_stalled/);
+ fixture.child.kill('SIGTERM');assert.deepEqual(await fixture.completed,{code:0,signal:null});
+});
