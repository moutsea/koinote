@@ -82,0 +83,8 @@
+		// A bound document task cannot be finished with a promise to start it.
+		// Check actual observations before trusting a second model's acceptance.
+		// Target-free conversation can still finish without reading a document.
+		const target = this.input.taskContext.finishAfterApplied;
+		if (target && this.state.targets.some(item => item.resourceId === target.resourceId || item.unresolved) && !this.readEvidence.length && !this.operations.length) {
+			if (canRevise) return { kind: "revise", feedback: "The requested document has not been read and no operation has been submitted. Continue the existing task using the available read tools. For an authorized revision, submit the actual revision for host review; for advice or a check requiring no changes, answer from the document read. A promise to read or edit later is not a completed result. Preserve all user restrictions and do not invent approval." };
+			throw new TaskIntentError("response_contract_failed", "Bound document task ended without any resource evidence or operation receipt");
+		}
