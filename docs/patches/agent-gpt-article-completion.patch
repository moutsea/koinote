+ it("continues a bound document task instead of accepting a promise with zero tool calls", async () => {
+  const f = fixture([interpretation(), {text:"I'll read the current document first."}, page("read",0), call("write"), review(), {text:"已提交修改。"}, audit()]);
+  f.input.taskContext!.finishAfterApplied={tool:"host.propose",resourceId:folders[0]};
+  f.input.systemPrompt="Application workflow: read the selected document, submit the requested revision for review, and answer in the user's language.";
+  const result=await f.kernel().run(f.input);
+  expect(f.propose).toHaveBeenCalledOnce();
+  expect(result.task?.outcome).toBe("operations_reported");
+  expect(result.task?.modelOutput).toBe("已提交修改。");
+  const requests=f.generate.mock.calls.map(([request])=>request);
+  expect(requests[2].messages.some(m=>m.role==="system"&&m.content.includes("has not been read"))).toBe(true);
+  for(const request of requests.filter(r=>r.tools.length===0)) {
+   const query=JSON.parse(request.messages.at(-1)!.content.split("\n").at(-1)!);
+   expect(query.applicationContract).toBe(f.input.systemPrompt);
+   expect(query.sourceMap.map((s:{id:string})=>s.id)).toEqual(["u1","a1","u2"]);
+  }
+ });
+ it("fails a bound document task after bounded empty promises instead of declaring completion", async () => {
+  const f=fixture([interpretation(),{text:"我先读取文章。"},{text:"马上开始润色。"},{text:"I'll read the current document first."}]);
+  f.input.taskContext!.finishAfterApplied={tool:"host.propose",resourceId:folders[0]};
+  await expect(f.kernel().run(f.input)).rejects.toMatchObject({code:"response_contract_failed"});
+  expect(f.generate).toHaveBeenCalledTimes(4);
+  expect(f.propose).not.toHaveBeenCalled();
+ });
+ it("allows advice or an unchanged result after reading a bound document without forcing a proposal", async () => {
+  const f=fixture([interpretation(),page("read",0),{text:"检查后没有需要修改的地方。"},audit()]);
+  f.input.taskContext!.finishAfterApplied={tool:"host.propose",resourceId:folders[0]};
+  const result=await f.kernel().run(f.input);
+  expect(result.task?.modelOutput).toBe("检查后没有需要修改的地方。");
+  expect(f.propose).not.toHaveBeenCalled();
+ });
+ it("does not force document tools for target-free conversation in the article sidebar", async () => {
+  const f=fixture([json({change:"continue",changeSources:[{messageId:"u2",quote:"是的"}],state:{...state,targets:[]}}),{text:"你好，有什么可以帮你？"},audit()]);
+  f.input.taskContext!.finishAfterApplied={tool:"host.propose",resourceId:folders[0]};
+  expect((await f.kernel().run(f.input)).task?.modelOutput).toBe("你好，有什么可以帮你？");
+  expect(f.propose).not.toHaveBeenCalled();
+ });
