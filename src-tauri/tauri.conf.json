{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Koinote",
  "version": "0.1.2",
  "identifier": "app.koinote.desktop",
  "build": {
    "frontendDist": "../spa/dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Koinote",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http://localhost:5273 data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://koinote.app https://img.koinote.app http://localhost:5273; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["koinote"]
      }
    },
    "sql": {
      "preload": ["sqlite:koinote-offline.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Offline-first Markdown writing with Koinote sync",
    "longDescription": "Koinote is a Markdown editor with offline document access and secure synchronization.",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
